# De trong = frontend goi API cung host voi trang dang mo, cong 3000.
# Nho vay may khac trong LAN mo http://<ip-may-chay>:5173 van chay binh thuong.
# start-zflix.bat tu dong cap nhat file nay moi lan khoi dong.
# Chi dien gia tri khi API nam o host khac, vd: VITE_API_URL=https://api.example.com
VITE_API_URL=

# Tùy chọn: JSON array ICE servers cho WebRTC voice/camera. Public STUN được dùng khi để trống.
# Production nên cấu hình thêm TURN để kết nối được qua NAT/firewall khó.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
VITE_WEBRTC_ICE_SERVERS=
