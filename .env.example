# ==============================================================================
# Zflix — biến môi trường cho docker-compose (đặt ở thư mục gốc, đổi tên thành .env)
# ==============================================================================

# Bắt buộc: bí mật ký JWT access token (tối thiểu 32 ký tự, sinh ngẫu nhiên)
# Ví dụ sinh:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Tùy chọn: khoá mã hoá secret TOTP khi bật MFA ở production (base64 của đúng 32 byte ngẫu nhiên)
# Ví dụ sinh:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Môi trường chạy (development/production)
NODE_ENV=development

# Origin của frontend cho CORS
FRONTEND_ORIGIN=http://localhost:5173
