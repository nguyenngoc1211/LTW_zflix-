# ==============================================================================
# Zflix — biến môi trường cho docker-compose (đặt ở thư mục gốc, đổi tên thành .env)
# ==============================================================================

# Bắt buộc: bí mật ký JWT access token (tối thiểu 32 ký tự, sinh ngẫu nhiên)
# Ví dụ sinh:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Tùy chọn: khoá riêng để ký token phát video (mặc định dùng JWT_ACCESS_SECRET)
PLAYBACK_TOKEN_SECRET=

# Tùy chọn: khoá mã hoá secret TOTP khi bật MFA ở production (base64 của đúng 32 byte ngẫu nhiên)
# Ví dụ sinh:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Môi trường chạy (development/production)
NODE_ENV=development

# Origin của frontend cho CORS
FRONTEND_ORIGIN=http://localhost:5173

# --- Cloudflare R2 (upload video/HLS cho quản lý phim nâng cao) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Bí mật chia sẻ giữa video-processor và backend cho webhook cập nhật URL HLS
VIDEO_WEBHOOK_SECRET=

# --- Nhận diện sản phẩm cho Lensy (visual shopping) ---
# none | deepseek | gemini | serpapi
VISION_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com
