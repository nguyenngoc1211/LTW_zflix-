# ==============================================================================
# Zflix backend — copy file này thành .env rồi điền giá trị cho máy bạn.
#   Windows (XAMPP): copy .env.example .env
#   hoặc chạy ..\setup-zflix.bat để script tự sinh file này.
# ==============================================================================

# --- Database (BẮT BUỘC) ---
# XAMPP mặc định: user root, mật khẩu rỗng -> mysql://root@localhost:3306/movie_streaming_db
# Nếu root có mật khẩu:            -> mysql://root:MAT_KHAU@localhost:3306/movie_streaming_db
# Docker compose (file .env ở gốc): -> mysql://root:rootpassword@db:3306/movie_streaming_db
DATABASE_URL=mysql://root@localhost:3306/movie_streaming_db
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Search (tùy chọn: nếu không cấu hình, discovery dùng MySQL LIKE fallback) ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=productions

# --- Auth (branch Du) ---
# Generate a unique secret of at least 32 characters. Never reuse this example value in production.
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
# Ký token phát video ngắn hạn (mặc định dùng JWT_ACCESS_SECRET nếu để trống).
PLAYBACK_TOKEN_SECRET=
# Required in production: base64 encoding of exactly 32 random bytes.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Zflix
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW_MS=300000
MFA_RATE_LIMIT_MAX=20
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=5
REFRESH_IDLE_TTL_DAYS=7
REFRESH_ABSOLUTE_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_SESSION_RETENTION_DAYS=30
PASSWORD_RESET_RETENTION_DAYS=7
MFA_CHALLENGE_RETENTION_DAYS=1
USED_RECOVERY_CODE_RETENTION_DAYS=30
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
RESET_PASSWORD_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_WINDOW_MS=900000
REGISTRATION_RATE_LIMIT_MAX=5
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=120
NODE_ENV=development

# --- Shoppable video (branch Ngoc) ---
# Prefix affiliate (ACCESSTRADE / Shopee Affiliate wrapper) — để trống thì dùng link Shopee search thường.
# Ví dụ: SHOPEE_AFFILIATE_PREFIX=https://r.accs.vn/xxxx/?url=
SHOPEE_AFFILIATE_PREFIX=
# Kiểu ACCESSTRADE (như các tool hoàn tiền): track base của campaign Shopee
# ví dụ: SHOPEE_AFFILIATE_TRACK_BASE=https://track.accesstrade.vn/v1/tracking/64474e6c9c9f5d.../click
SHOPEE_AFFILIATE_TRACK_BASE=
# Định danh nguồn đi kèm link (sub_id) để thống kê hoa hồng
SHOPEE_AFFILIATE_SUB_ID=zflix

# --- Shopee Affiliate Open API (affiliate.shopee.vn -> open.affiliate.shopee.vn) ---
# Đăng ký app tại open.affiliate.shopee.vn để nhận APP_ID + SECRET_KEY.
# Có key: quét đồ vật hiện sản phẩm Shopee THẬT (ảnh/giá/hoa hồng) và nút Mua
# trả short link s.shopee.vn gắn tracking của bạn.
SHOPEE_AFF_APP_ID=
SHOPEE_AFF_SECRET_KEY=
SHOPEE_AFF_API_BASE=https://open-api.affiliate.shopee.vn

# --- AI nhận diện ảnh cho quét đồ vật (tùy chọn) ---
# gemini (khuyên dùng): key free tại aistudio.google.com/apikey (1500 ảnh/ngày, không cần thẻ)
VISION_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# serpapi Google Lens: cần SERPAPI_KEY + PUBLIC_BASE_URL (ảnh phải public trên internet)
SERPAPI_KEY=
# DeepSeek vision (OpenAI-compatible): đặt VISION_PROVIDER=deepseek rồi điền key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com
PUBLIC_BASE_URL=

# --- Cloudflare R2 + webhook video (nhánh Nam) ---
# Dùng cho upload video/HLS và xoá file khi xoá phim
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
# Bắt buộc khớp với video-processor; webhook từ chối nếu để trống
VIDEO_WEBHOOK_SECRET=

# --- Python video-processor (port 8001) ---
# Local trên Windows: http://127.0.0.1:8001
# Trong docker-compose: http://video_service:8001 (compose đã set sẵn)
VIDEO_SERVICE_URL=http://127.0.0.1:8001
