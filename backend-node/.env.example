DATABASE_URL=mysql://root:rootpassword@localhost:3306/movie_streaming_db
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Generate a unique secret of at least 32 characters. Never reuse this example value in production.
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
# Required in production: base64 encoding of exactly 32 random bytes.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=MovieHub
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW_MS=300000
MFA_RATE_LIMIT_MAX=20
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=5
REFRESH_IDLE_TTL_DAYS=7
REFRESH_ABSOLUTE_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
RESET_PASSWORD_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=120
NODE_ENV=development
